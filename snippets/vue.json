  "Vue3 setup with props and emits": {
    "isFileTemplate": true,
    "prefix": "v3-ts-props",
    "body": [
      "<template>",
      "  <div>",
      "    {{ title }}",
      "    $1",
      "  </div>",
      "</template>",
      "",
      "<script setup lang=\"ts\">",
      "interface Props {",
      "  title?: string",
      "}",
      "",
      "withDefaults(defineProps<Props>(), {",
      "  title: '',",
      "})",
      "",
      "const emit = defineEmits<{",
      "  change: [value: string]",
      "}>()",
      "</script>",
      "",
      "<style scoped>",
      "",
      "</style>"
    ],
    "description": "Vue3 · 组合式 API + defineProps / defineEmits"
