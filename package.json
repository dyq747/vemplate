{
  "name": "vemplate",
  "publisher": "bbwhunter",
  "displayName": "Vue Template File",
  "description": "Create Vue single-file components from snippets",
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dyq747/vemplate"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "icon": "vue-2-3.png",
  "main": "./dist/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "vue",
        "path": "./snippets/vue.json"
      }
    ],
    "commands": [
      {
        "command": "vemplate",
        "title": "Vemplate"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vemplate",
          "group": "navigation",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "Vemplate",
      "properties": {
        "vemplate.extraSnippetFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "额外的片段目录（绝对路径），用于补充自动检测到的用户片段目录"
        },
        "vemplate.includeExtensionSnippets": {
          "type": "boolean",
          "default": true,
          "description": "是否把其它扩展贡献的 Vue 片段也加入列表（列表的来源列会显示对应插件名）"
        },
        "vemplate.previewSnippetContent": {
          "type": "boolean",
          "default": true,
          "description": "选择片段时在侧边打开只读预览"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
